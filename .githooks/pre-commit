#!/usr/bin/env bash
set -euo pipefail

if ! command -v clang-format >/dev/null 2>&1; then
    echo "pre-commit: clang-format is not installed or not on PATH" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

mapfile -d '' files < <(
    git diff --cached --name-only -z --diff-filter=ACMR |
        grep -zE '\.(c|cc|cpp|cxx|h|hh|hpp|hxx)$' || true
)

if [ "${#files[@]}" -eq 0 ]; then
    exit 0
fi

echo "pre-commit: running clang-format on staged C/C++ files"

for file in "${files[@]}"; do
    if [ -f "$file" ]; then
        clang-format -i --style=file "$file"
        git add "$file"
    fi
done

exit 0
