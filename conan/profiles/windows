# Windows base profile: VS 2022 bundled clang-cl 19 + Ninja, MSVC ABI.
#
# This profile is platform/toolchain only — it intentionally does NOT set
# `build_type` or `compiler.runtime_type`. Use one of:
#
#   conan/profiles/windows-debug     # build_type=Debug,   runtime_type=Debug   (MDd)
#   conan/profiles/windows-release   # build_type=Release, runtime_type=Release (MD)
#
# Both inherit from this file via Conan's `include()` directive.

[settings]
os=Windows
arch=x86_64
compiler=clang
compiler.version=19
compiler.cppstd=17
compiler.runtime=dynamic
compiler.runtime_version=v144

[buildenv]
CC=clang-cl
CXX=clang-cl

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:compiler_executables={"c": "clang-cl", "cpp": "clang-cl"}
