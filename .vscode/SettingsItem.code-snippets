{
	// Place your CppPrototype workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders.
	// Placeholders with the same ids are connected.
	// Example:
	"Setting Include": {
		"scope": "cpp",
		"prefix": "snippet_inc_setting",
		"body":
		[
			"#include \"settings/dirty_tracker.hpp\"",
			"#include \"settings/settings_item.hpp\""
		]
	},
	"Setting Template": {
		"scope": "cpp",
		"prefix": "snippet_setting",
		"body": [
			"struct $1Settings : DirtyTracker",
			"{",
			"    NLOHMANN_DEFINE_TYPE_INTRUSIVE($1Settings)",
			"protected:",
			"    void onChanged() override;",
			"};",
			"extern SettingsItem<$1Settings> g_$1Settings;",
		],
		"description": "Create a SettingsItem instance"
	}
